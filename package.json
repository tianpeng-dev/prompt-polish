{
  "name": "prompt-refiner-mvp",
  "version": "1.4.0",
  "description": "驻留在 macOS 菜单栏或 Windows 系统托盘的 Trae 提示词优化器",
  "author": "精炼台",
  "private": true,
  "type": "module",
  "main": "dist/desktop/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "postinstall": "install-electron",
    "prebuild": "pnpm clean",
    "dev": "pnpm build && electron .",
    "build": "tsc -p tsconfig.json && node scripts/bundle.mjs",
    "start": "electron .",
    "icons": "bash scripts/build-icons.sh",
    "pack:mac": "pnpm build && pnpm icons && node scripts/pack-mac.mjs",
    "pack:win": "pnpm build && electron-builder --win nsis --x64 --publish never",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check src desktop tests scripts/*.mjs package.json",
    "smoke:electron": "pnpm build && electron scripts/smoke-electron.mjs",
    "smoke:main": "pnpm build && electron scripts/smoke-main.mjs",
    "test": "vitest run --dir tests",
    "test:watch": "vitest --dir tests"
  },
  "devDependencies": {
    "@fontsource/geist": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tabler/icons": "3.46.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.3",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "jsdom": "30.1.1",
    "prettier": "^3.9.9",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@9.15.0",
  "build": {
    "appId": "com.local.prompt-refiner",
    "productName": "精炼台",
    "asar": true,
    "afterPack": "scripts/after-pack.mjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/src/**/*",
      "dist/desktop/**/*",
      "dist/fonts/**/*",
      "desktop/renderer/**/*",
      "!desktop/renderer/**/*.ts",
      "prompts/trae-cn-input-optimization.md",
      "assets/app-icon.icns",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets/tray-iconTemplate.png",
        "to": "tray-iconTemplate.png"
      },
      {
        "from": "assets/tray-iconTemplate@2x.png",
        "to": "tray-iconTemplate@2x.png"
      },
      {
        "from": "assets/tray-icon-win.png",
        "to": "tray-icon-win.png"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "assets/app-icon.icns",
      "artifactName": "JingLianTai-${version}-mac-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false,
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/app-icon.png",
      "artifactName": "JingLianTai-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "精炼台"
    }
  }
}
